GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Chuỗi bí mật dùng để ký cookie phiên đăng nhập (tối thiểu 32 ký tự ngẫu nhiên)
AUTH_SECRET="THAY_BANG_CHUOI_BI_MAT_NGAU_NHIEN_IT_NHAT_32_KY_TU"

# URL ứng dụng
APP_URL="http://localhost:3000"
